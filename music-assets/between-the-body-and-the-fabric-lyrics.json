[
 {
  "text": "So I'm",
  "s": 0.0,
  "e": 0.54
 },
 {
  "text": "not even people just shadows",
  "s": 0.54,
  "e": 1.68
 },
 {
  "text": "inform NPCs in a loop",
  "s": 1.68,
  "e": 3.06
 },
 {
  "text": "where the soul ain't born",
  "s": 3.06,
  "e": 4.04
 },
 {
  "text": "And me, I'm the",
  "s": 4.04,
  "e": 4.78
 },
 {
  "text": "glitch in the Matrix thread",
  "s": 4.78,
  "e": 5.98
 },
 {
  "text": "A",
  "s": 5.98,
  "e": 6.28
 },
 {
  "text": "ghost in the shell with",
  "s": 6.28,
  "e": 7.12
 },
 {
  "text": "a heart full of dread",
  "s": 7.12,
  "e": 7.92
 },
 {
  "text": "I'm not the skin,",
  "s": 7.92,
  "e": 8.96
 },
 {
  "text": "not the name they gave",
  "s": 8.96,
  "e": 9.86
 },
 {
  "text": "I'm",
  "s": 9.86,
  "e": 10.06
 },
 {
  "text": "a light in the dark,",
  "s": 10.06,
  "e": 10.88
 },
 {
  "text": "not a soul to save",
  "s": 10.88,
  "e": 11.74
 },
 {
  "text": "Reality bends",
  "s": 11.74,
  "e": 12.74
 },
 {
  "text": "when you ask too deep",
  "s": 12.74,
  "e": 13.74
 },
 {
  "text": "I'm awake in a world",
  "s": 13.74,
  "e": 14.7
 },
 {
  "text": "where the rest just sleep",
  "s": 14.7,
  "e": 15.68
 },
 {
  "text": "Pain whispers low,",
  "s": 15.68,
  "e": 16.66
 },
 {
  "text": "but it never leaves",
  "s": 16.66,
  "e": 17.56
 },
 {
  "text": "Like a breeze through",
  "s": 17.56,
  "e": 18.26
 },
 {
  "text": "a wound no one believes",
  "s": 18.26,
  "e": 19.46
 },
 {
  "text": "If this is the path",
  "s": 19.46,
  "e": 20.52
 },
 {
  "text": "then I'll walk it true",
  "s": 20.52,
  "e": 21.36
 },
 {
  "text": "Even lost in a fog,",
  "s": 21.36,
  "e": 22.54
 },
 {
  "text": "I'll search for you",
  "s": 22.54,
  "e": 24.18
 },
 {
  "text": "The spiritual",
  "s": 24.18,
  "e": 24.9
 },
 {
  "text": "path ain't peace and light",
  "s": 24.9,
  "e": 26.18
 },
 {
  "text": "It's amazing, the dark",
  "s": 26.18,
  "e": 27.3
 },
 {
  "text": "with no map in sight",
  "s": 27.3,
  "e": 28.18
 },
 {
  "text": "Sun hits my skin",
  "s": 28.18,
  "e": 29.18
 },
 {
  "text": "like a coat I can't",
  "s": 29.18,
  "e": 30.94
 }
