 },
 {
  "text": "not the kind they test",
  "s": 10.32,
  "e": 11.48
 },
 {
  "text": "It's the soul",
  "s": 11.48,
  "e": 12.06
 },
 {
  "text": "recognizing what the world suppressed",
  "s": 12.06,
  "e": 13.8
 },
 {
  "text": "You are not just body,",
  "s": 13.8,
  "e": 15.1
 },
 {
  "text": "not just hunger,",
  "s": 15.1,
  "e": 15.74
 },
 {
  "text": "not just name",
  "s": 15.74,
  "e": 16.42
 },
 {
  "text": "Not just",
  "s": 16.42,
  "e": 16.84
