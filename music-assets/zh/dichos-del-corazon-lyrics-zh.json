[
 {
  "text": "那团火，在最深的夜里",
  "en": "El fuego que se calma",
  "s": 0.0,
  "e": 0.58
 },
 {
  "text": "慢慢地静了下来",
  "en": "en la noche más oscura",
  "s": 0.58,
  "e": 1.52
 },
 {
  "text": "我们从老话里学东西",
  "en": "From dichos, we learn",
  "s": 1.52,
  "e": 3.44
 },
 {
  "text": "它们回响得那么真",
  "en": "They echo so true",
  "s": 3.44,
  "e": 4.7
 },
 {
  "text": "指引你的每一步",
  "en": "Guiding your steps",
  "s": 4.7,
  "e": 5.94
 },
 {
  "text": "在你做的每一件事里",
  "en": "in all that you do",
  "s": 5.94,
  "e": 7.32
 },
 {
  "text": "天气再坏",
  "en": "Al mal tiempo,",
  "s": 7.32,
  "e": 8.48
 },
 {
  "text": "也要摆一张好脸",
  "en": "buena cara siempre",
  "s": 8.48,
  "e": 9.48
 },
 {
  "text": "一颗强韧的心",
  "en": "El corazón fuerte,",
  "s": 9.48,
  "e": 11.04
 },
 {
  "text": "从来不会停下",
  "en": "nunca se detiene",
  "s": 11.04,
  "e": 12.04
 },
 {
  "text": "从说到做",
  "en": "Del dicho al hecho,",
  "s": 12.04,
  "e": 13.5
 },
 {
  "text": "中间那段路很长",
  "en": "el trecho es largo",
  "s": 13.5,
  "e": 14.64
 },
 {
  "text": "但只要还有信心",
  "en": "Pero con fe,",
  "s": 14.64,
  "e": 16.1
 },
 {
  "text": "我们就能穿过那些苦",
  "en": "cruzamos lo amargo",
  "s": 16.1,
  "e": 17.4
 },
