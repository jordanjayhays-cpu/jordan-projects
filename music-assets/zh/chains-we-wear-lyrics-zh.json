 {
  "text": "恐惧藏在心里很深的地方",
  "en": "Fear deep inside,",
  "s": 0.0,
  "e": 1.16
 },
 {
  "text": "但卢梭提醒我们",
  "en": "But Rousseau reminds us",
  "s": 1.16,
  "e": 2.22
 },
 {
  "text": "一切其实都在我们自己手里",
  "en": "it's all in our hands",
  "s": 2.22,
  "e": 3.22
 },
 {
  "text": "自由不是别人赐的",
