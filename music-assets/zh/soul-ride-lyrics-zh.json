[
 {
  "text": "这不过是一趟过山车",
  "en": "It's just a ride",
  "s": 0.0,
  "e": 1.24
 },
 {
  "text": "只是一趟过山车",
  "en": "just a ride",
  "s": 1.24,
  "e": 2.22
 },
 {
  "text": "别抓太紧，你还活着",
  "en": "Hold on loose, you're alive",
  "s": 2.22,
  "e": 4.58
 },
 {
  "text": "他们告诉我",
  "en": "They told me this",
  "s": 4.58,
  "e": 5.7
 },
 {
  "text": "这是真的，别松手",
  "en": "is real, don't let go",
  "s": 5.7,
  "e": 7.64
 },
 {
  "text": "于是我抓得死紧",
  "en": "So I held on tight",
  "s": 7.64,
  "e": 8.84
 },
 {
  "text": "怕自己掉下去",
  "en": "didn't wanna fall",
  "s": 8.84,
  "e": 9.94
 },
 {
  "text": "灯光飞闪，音响轰鸣",
  "en": "Lights flashing fast, speakers loud",
  "s": 9.94,
  "e": 13.26
 },
 {
  "text": "人群里所有人都在尖叫",
  "en": "Everybody screaming in the crowd",
  "s": 13.26,
  "e": 15.2
 },
 {
  "text": "往上冲，往下坠",
  "en": "Ride, go up, ride",
  "s": 15.2,
  "e": 16.8
 },
 {
  "text": "一次又一次",
  "en": "go down",
  "s": 16.8,
  "e": 17.36
 },
 {
  "text": "有时笑，有时随手拨弦",
  "en": "Someday smile, someday strum",
  "s": 17.36,
  "e": 19.94
 },
 {
  "text": "我在这里坐得太久",
  "en": "Been in here so long",
  "s": 19.94,
  "e": 21.72
 },
 {
  "text": "久到忘了一件事",
  "en": "I forgot one thing",
  "s": 21.72,
  "e": 22.9
 },
 {
  "text": "这座位是我自己选的",
  "en": "I chose this seat",
  "s": 22.9,
  "e": 24.22
 },
 {
  "text": "我不是被困在这里",
  "en": "I'm not stuck in it",
  "s": 24.22,
  "e": 25.74
 },
 {
  "text": "有人问",
  "en": "Some folks ask",
  "s": 25.74,
  "e": 26.96
 },
 {
  "text": "就只有这些了吗",
  "en": "is this all there is?",
  "s": 26.96,
  "e": 28.5
 },
 {
  "text": "也有人笑着说，别问",
  "en": "Others laugh, say don't",
  "s": 28.5,
  "e": 31.44
 }
]