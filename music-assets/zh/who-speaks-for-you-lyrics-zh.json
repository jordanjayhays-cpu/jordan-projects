[
 {
  "text": "缰绳握在谁手里",
  "en": "Who holds the reins?",
  "s": 0.0,
  "e": 2.0
 },
 {
  "text": "票又是谁投的",
  "en": "Who cast the votes?",
  "s": 2.0,
  "e": 3.3
 },
 {
  "text": "以你的名义，一套",
  "en": "In your name, a system",
  "s": 3.3,
  "e": 5.1
 },
 {
  "text": "建立在我们的选择之上的制度",
  "en": "built on what we choose",
  "s": 5.1,
  "e": 7.06
 },
 {
  "text": "可是",
  "en": "But how",
  "s": 7.06,
  "e": 7.72
 },
 {
  "text": "我们真正用上了多少权力",
  "en": "much power do we use?",
  "s": 7.72,
  "e": 10.14
 },
 {
  "text": "竞选广告",
  "en": "Political ads,",
  "s": 10.14,
  "e": 11.38
 },
 {
  "text": "把你的屏幕灌满",
  "en": "they flood your screen",
  "s": 11.38,
  "e": 13.04
 },
 {
  "text": "口号和笑脸",
  "en": "Slogans and smiles,",
  "s": 13.04,
  "e": 14.9
 },
 {
  "text": "可它们到底在说什么",
  "en": "but what do they mean?",
  "s": 14.9,
  "e": 16.12
 },
 {
  "text": "辩论变成了一场演出",
  "en": "Debates turn to drama,",
  "s": 16.12,
  "e": 17.68
 },
 {
  "text": "真话越来越难找",
  "en": "truth's hard to find",
  "s": 17.68,
  "e": 18.7
 },
 {
  "text": "我们凭印象投票",
  "en": "We vote on impressions,",
  "s": 18.7,
  "e": 20.24
 },
 {
  "text": "不是凭政策条文",
  "en": "not policy lines",
  "s": 20.24,
  "e": 21.3
 },
 {
  "text": "那些法官，你认识吗",
  "en": "Do you know the judges?",
  "s": 21.3,
  "e": 23.12
 },
 {
  "text": "那些议席",
  "en": "The council seats,",
  "s": 23.12,
  "e": 24.46
 },
 {
  "text": "选票上的那些职位",
  "en": "the roles on your ballot",
  "s": 24.46,
  "e": 25.5
 },
 {
  "text": "你几乎没打过交道",
  "en": "That you barely meet?",
  "s": 25.5,
  "e": 27.1
 },
 {
  "text": "那是一座由名字组成的迷宫",
  "en": "It's a maze of names,",
  "s": 27.1,
  "e": 28.4
 },
 {
  "text": "每个位置是干什么的，没人说得清",
  "en": "positions unknown",
  "s": 28.4,
  "e": 29.44
 },
 {
  "text": "我们",
  "en": "We...",
  "s": 29.44,
  "e": 30.94
 }
]