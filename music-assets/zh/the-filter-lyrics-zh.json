[
 {
  "text": "别管什么设计",
  "en": "Never mind design",
  "s": 0.0,
  "e": 2.62
 },
 {
  "text": "我要打破这层滤镜",
  "en": "but I'm breaking the filter",
  "s": 2.62,
  "e": 5.02
 },
 {
  "text": "我要把时间夺回来",
  "en": "I'm taking back time",
  "s": 5.02,
  "e": 8.28
 },
 {
  "text": "人走进一个房间",
  "en": "People walk in a room",
  "s": 8.28,
  "e": 9.84
 },
 {
  "text": "却忘了自己为什么来",
  "en": "and forgot why you came",
  "s": 9.84,
  "e": 11.08
 },
 {
  "text": "是你的脑子在删除",
  "en": "It's your mind deleting",
  "s": 11.08,
  "e": 11.9
 },
 {
  "text": "记忆游戏里的那些念头",
  "en": "thoughts in a memory game",
  "s": 11.9,
  "e": 13.44
 },
 {
  "text": "新的",
  "en": "New",
  "s": 13.44,
  "e": 13.88
 },
 {
  "text": "语境抹去，旧的感觉被顶替",
  "en": "context erased, past feelings displaced",
  "s": 13.88,
  "e": 15.98
 },
 {
  "text": "想象力被换成了社会的那张脸",
  "en": "Imagination replaced with society's face",
  "s": 15.98,
  "e": 18.38
 },
 {
  "text": "我们曾经能看见",
  "en": "We used to see",
  "s": 18.38,
  "e": 19.46
 },
 {
  "text": "云里的城堡和纸箱",
  "en": "castles and cardboard in clouds",
  "s": 19.46,
  "e": 21.04
 },
 {
  "text": "而现在",
  "en": "Now",
  "s": 21.04,
  "e": 21.24
 },
 {
  "text": "我们刷到麻木",
  "en": "we scroll to a numb",
  "s": 21.24,
  "e": 22.54
 },
 {
  "text": "深深迷失在人群里",
  "en": "lost deep in the crowd",
  "s": 22.54,
  "e": 23.44
 },
 {
  "text": "实用主义杀死了",
  "en": "Practicality killed",
  "s": 23.44,
  "e": 24.92
 },
 {
  "text": "那些野性和大胆",
  "en": "what was wild and bold",
  "s": 24.92,
  "e": 25.96
 },
 {
  "text": "直到我们拿火",
  "en": "Till we traded the fire",
  "s": 25.96,
  "e": 26.92
 },
 {
  "text": "换来了金和银",
  "en": "for silver and gold",
  "s": 26.92,
  "e": 28.44
 },
 {
  "text": "但念头不过是习惯",
  "en": "But thoughts are just habits",
  "s": 28.44,
  "e": 31.3
 }
]