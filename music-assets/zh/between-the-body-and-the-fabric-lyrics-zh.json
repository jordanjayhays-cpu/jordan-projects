[
 {
  "text": "你们",
  "en": "So I'm",
  "s": 0.0,
  "e": 0.54
 },
 {
  "text": "根本不算人 只是影子",
  "en": "not even people just shadows",
  "s": 0.54,
  "e": 1.68
 },
 {
  "text": "有个形状 循环里的 NPC",
  "en": "in form, NPCs in a loop",
  "s": 1.68,
  "e": 3.06
 },
 {
  "text": "灵魂从没在那里诞生",
  "en": "where the soul ain't born",
  "s": 3.06,
  "e": 4.04
 },
 {
  "text": "而我 是",
  "en": "And me, I'm the",
  "s": 4.04,
  "e": 4.78
 },
 {
  "text": "矩阵那段线程里的故障",
  "en": "glitch in the Matrix thread",
  "s": 4.78,
  "e": 5.98
 },
 {
  "text": "一个",
  "en": "A",
  "s": 5.98,
  "e": 6.28
 },
 {
  "text": "壳中的幽灵 带着",
  "en": "ghost in the shell with",
  "s": 6.28,
  "e": 7.12
 },
 {
  "text": "一颗装满恐惧的心",
  "en": "a heart full of dread",
  "s": 7.12,
  "e": 7.92
 },
 {
  "text": "我不是这层皮",
  "en": "I'm not the skin,",
  "s": 7.92,
  "e": 8.96
 },
 {
  "text": "也不是他们给的名字",
  "en": "not the name they gave",
  "s": 8.96,
  "e": 9.86
 },
 {
  "text": "我是",
  "en": "I'm",
  "s": 9.86,
  "e": 10.06
 },
 {
  "text": "黑暗里的一点光",
  "en": "a light in the dark,",
  "s": 10.06,
  "e": 10.88
 },
 {
  "text": "不是等着被拯救的灵魂",
  "en": "not a soul to save",
  "s": 10.88,
  "e": 11.74
 },
 {
  "text": "现实会弯曲",
  "en": "Reality bends",
  "s": 11.74,
  "e": 12.74
 },
 {
  "text": "当你问得太深",
  "en": "when you ask too deep",
  "s": 12.74,
  "e": 13.74
 },
 {
  "text": "我在一个世界里醒着",
  "en": "I'm awake in a world",
  "s": 13.74,
  "e": 14.7
 },
 {
  "text": "而其他人都还睡着",
  "en": "where the rest just sleep",
  "s": 14.7,
  "e": 15.68
 },
 {
  "text": "痛低声说话",
  "en": "Pain whispers low,",
  "s": 15.68,
  "e": 16.66
 },
 {
  "text": "但它从不离开",
  "en": "but it never leaves",
  "s": 16.66,
  "e": 17.56
 },
 {
  "text": "像一阵风穿过",
  "en": "Like a breeze through",
  "s": 17.56,
  "e": 18.26
 },
 {
  "text": "一道没人相信的伤口",
  "en": "a wound no one believes",
  "s": 18.26,
  "e": 19.46
 },
 {
  "text": "如果这就是那条路",
  "en": "If this is the path",
  "s": 19.46,
  "e": 20.52
 },
 {
  "text": "那我就老老实实走完",
  "en": "then I'll walk it true",
  "s": 20.52,
  "e": 21.36
 },
 {
  "text": "就算迷在雾里",
  "en": "Even lost in a fog,",
  "s": 21.36,
  "e": 22.54
 },
 {
  "text": "我也会去找你",
  "en": "I'll search for you",
  "s": 22.54,
  "e": 24.18
 },
 {
  "text": "修行这条路",
  "en": "The spiritual",
  "s": 24.18,
  "e": 24.9
 },
 {
  "text": "不是平静 也不是光",
  "en": "path ain't peace and light",
  "s": 24.9,
  "e": 26.18
 },
 {
  "text": "是一座黑暗里的迷宫",
  "en": "It's a maze in the dark",
  "s": 26.18,
  "e": 27.3
 },
 {
  "text": "手上没有地图",
  "en": "with no map in sight",
  "s": 27.3,
  "e": 28.18
 },
 {
  "text": "阳光打在皮肤上",
  "en": "Sun hits my skin",
  "s": 28.18,
  "e": 29.18
 },
 {
  "text": "像一件我脱不掉的外套",
  "en": "like a coat I can't",
  "s": 29.18,
  "e": 30.94
 }
]