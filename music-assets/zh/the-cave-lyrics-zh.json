[
 {
  "text": "每一步都是一次死亡",
  "en": "Each step was a death,",
  "s": 0.0,
  "e": 1.46
 },
 {
  "text": "每一个真相都是重生",
  "en": "each truth was reborn",
  "s": 1.46,
  "e": 2.64
 },
 {
  "text": "洞穴被甩在身后",
  "en": "The cave fell behind,",
  "s": 2.64,
  "e": 4.28
 },
 {
  "text": "阳光灼人",
  "en": "the sunlight burned",
  "s": 4.28,
  "e": 5.26
 },
 {
  "text": "一个世界",
  "en": "A world",
  "s": 5.26,
  "e": 5.98
 },
 {
  "text": "超出我从前见过的一切",
  "en": "beyond what I'd ever discerned",
  "s": 5.98,
  "e": 8.26
 },
 {
  "text": "影子",
  "en": "Shadows",
  "s": 8.26,
  "e": 8.78
 },
 {
  "text": "在黑暗滋长的地方起舞",
  "en": "dance where the darkness thrives",
  "s": 8.78,
  "e": 10.8
 },
 {
  "text": "困在幻象里 追着谎言跑",
  "en": "Trapped in illusions, chasing lies",
  "s": 10.8,
  "e": 13.22
 },
 {
  "text": "挣断锁链 走出去",
  "en": "Break the chains, step outside",
  "s": 13.22,
  "e": 15.88
 },
 {
  "text": "洞穴消散",
  "en": "The cave dissolves,",
  "s": 15.88,
  "e": 17.44
 },
 {
  "text": "真相的光撞了进来",
  "en": "truth's light collides",
  "s": 17.44,
  "e": 18.8
 },
 {
  "text": "走出洞穴",
  "en": "Outside the cave,",
  "s": 18.8,
  "e": 20.3
 },
 {
  "text": "我看见了天空",
  "en": "I saw the sky",
  "s": 20.3,
  "e": 21.2
 },
 {
  "text": "星星",
  "en": "The stars,",
  "s": 21.2,
  "e": 22.28
 },
 {
  "text": "太阳 还有那些为什么",
  "en": "the sun, the questions why",
  "s": 22.28,
  "e": 23.9
 },
 {
  "text": "真相并不温柔",
  "en": "Truth ain't easy,",
  "s": 23.9,
  "e": 25.6
 },
 {
  "text": "它锋利 它冰冷",
  "en": "it's sharp, it's cold",
  "s": 25.6,
  "e": 26.56
 },
 {
  "text": "但它是自由",
  "en": "But it's freedom",
  "s": 26.56,
  "e": 27.42
 },
 {
  "text": "挣脱那些被兜售的谎言",
  "en": "from the lies we're sold",
  "s": 27.42,
  "e": 29.18
 },
 {
  "text": "我又回去了",
  "en": "I went back",
  "s": 29.18,
  "e": 31.44
 }
]