[
 {
  "text": "从真相那儿",
  "en": "From the truth,",
  "s": 0.0,
  "e": 0.72
 },
 {
  "text": "可我们得到的真相",
  "en": "but the truth we get",
  "s": 0.72,
  "e": 1.96
 },
 {
  "text": "文化是一层遮盖，野心",
  "en": "Cultures, a cover, ambitions",
  "s": 1.96,
  "e": 3.86
 },
 {
  "text": "呼吸，全都搭在",
  "en": "Breath all built on",
  "s": 3.86,
  "e": 5.5
 },
 {
  "text": "对那个影子的恐惧上",
  "en": "the fear of the shadow",
  "s": 5.5,
  "e": 7.64
 },
 {
  "text": "死",
  "en": "Death,",
  "s": 7.64,
  "e": 8.48
 },
 {
  "text": "死，死，死，死，死",
  "en": "death, death, death, death, death",
  "s": 8.48,
  "e": 12.86
 },
 {
  "text": "弗洛伊德说是性",
  "en": "Freud said sex,",
  "s": 12.86,
  "e": 14.26
 },
 {
  "text": "可贝克尔说不是",
  "en": "but Becker said no",
  "s": 14.26,
  "e": 15.24
 },
 {
  "text": "核心里是死",
  "en": "It's death in the core,",
  "s": 15.24,
  "e": 16.62
 },
 {
  "text": "河从那里流出来",
  "en": "where the rivers flow",
  "s": 16.62,
  "e": 18.0
 },
 {
  "text": "我们把这个念头埋了",
  "en": "We buried the thought",
  "s": 18.0,
  "e": 19.12
 },
 {
  "text": "埋在十字架和王冠底下",
  "en": "with the cross over crown",
  "s": 19.12,
  "e": 20.6
 },
 {
  "text": "可坟墓",
  "en": "But the grave",
  "s": 20.6,
  "e": 21.24
 },
 {
  "text": "不在乎谁建了什么帝国",
  "en": "don't care what empire's found",
  "s": 21.24,
  "e": 23.3
 },
 {
  "text": "英雄会起来",
  "en": "Heroes rise,",
  "s": 23.3,
  "e": 24.66
 },
 {
  "text": "可泥土照样收走国王",
  "en": "but the soil takes kings",
  "s": 24.66,
  "e": 25.96
 },
 {
  "text": "每一种",
  "en": "Every",
  "s": 25.96,
  "e": 26.58
 },
 {
  "text": "宗教，都是一只带翅膀的笼子",
  "en": "religions a cage with wings",
  "s": 26.58,
  "e": 28.44
 },
 {
  "text": "我们亲手造出幻觉",
  "en": "We craft delusions",
  "s": 28.44,
  "e": 30.84
 }
