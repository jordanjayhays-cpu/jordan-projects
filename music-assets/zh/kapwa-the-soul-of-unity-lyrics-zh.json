[
 {
  "text": "有一种爱",
  "en": "May pagmamahal,",
  "s": 0.0,
  "e": 1.88
 },
 {
  "text": "从来不会变",
  "en": "hindi nag-iiba",
  "s": 1.88,
  "e": 4.82
 },
 {
  "text": "牵着手",
  "en": "Hawak",
  "s": 4.82,
  "e": 5.34
 },
 {
  "text": "一起走过苦和乐",
  "en": "kamay sa hirap at saya",
  "s": 5.34,
  "e": 8.78
 },
 {
  "text": "团结才是真正的价值",
  "en": "Pagkakaisa ang tunay na halaga",
  "s": 8.78,
  "e": 12.28
 },
 {
  "text": "巴雅尼汉的精神，一起扛起重担",
  "en": "Bayanihan spirit lifting the load",
  "s": 12.28,
  "e": 14.22
 },
 {
  "text": "我们一起",
  "en": "Together",
  "s": 14.22,
  "e": 14.58
 },
 {
  "text": "走这条坎坷的路",
  "en": "we walk life's rugged road",
  "s": 14.58,
  "e": 16.18
 },
 {
  "text": "在共有的人性里",
  "en": "No one stands",
  "s": 16.18,
  "e": 16.74
 },
 {
  "text": "没有人是孤单的",
  "en": "alone in the shared humanity",
  "s": 16.74,
  "e": 18.32
 },
 {
  "text": "Kapwa",
  "en": "Kapwa,",
  "s": 18.32,
  "e": 18.78
 },
 {
  "text": "真正的合一就是这个词",
  "en": "the essence of true unity",
  "s": 18.78,
  "e": 19.98
 },
 {
  "text": "不是为了得到",
  "en": "It's not about gain,",
  "s": 19.98,
  "e": 21.36
 },
 {
  "text": "也不是为了面子",
  "en": "not about pride",
  "s": 21.36,
  "e": 22.18
 },
 {
  "text": "而是",
  "en": "But the",
  "s": 22.18,
  "e": 22.46
 },
 {
  "text": "我们心里共有的那条连接",
  "en": "shared connection we hold inside",
  "s": 22.46,
  "e": 24.16
 },
 {
  "text": "你帮你的邻居",
  "en": "When you help your neighbor,",
  "s": 24.16,
  "e": 25.4
 },
 {
  "text": "其实是在帮自己",
  "en": "you help yourself",
  "s": 25.4,
  "e": 26.14
 },
 {
  "text": "在给出去的时候",
  "en": "In giving",
  "s": 26.14,
  "e": 26.68
 },
 {
  "text": "人反而变得富足",
  "en": "one rich with soulful wealth",
  "s": 26.68,
  "e": 28.16
 },
 {
  "text": "世界也许会把我们分开",
  "en": "The world may divide us,",
  "s": 28.16,
  "e": 29.38
 },
 {
  "text": "但真相是这样的",
  "en": "but here's the truth",
  "s": 29.38,
  "e": 31.4
 }
]
